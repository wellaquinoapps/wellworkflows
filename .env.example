# Supabase Environment Variables & Secrets Example
# Copy or set these in your Supabase project (via dashboard or `supabase secrets set`)

# 1. Supabase Project URLs and Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Master Key for AES-256-GCM Credential Encryption
# MUST be a strong 32+ character high-entropy secret or 64-hex string.
# Keep this secure! If lost, saved API credentials cannot be decrypted.
MASTER_ENCRYPTION_KEY=super-secret-random-master-key-minimum-32-chars-length-here

